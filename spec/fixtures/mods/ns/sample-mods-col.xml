    <mods:note type="acquisition" displayLabel="Provenance">Acquired by Trinity College Library from David Clarke, October 2002</mods:note>
    <mods:note type="bibliography" displayLabel="Bibliography" />
    <mods:note type="funding" displayLabel="Sponsor">Digital Repository of Ireland</mods:note>
